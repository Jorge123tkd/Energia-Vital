{
  "name": "energia-vital",
  "version": "1.0.0",
  "private": true,
  "description": "Energía Vital — Plataforma comercial inteligente con asistente conversacional",
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/api",
    "deploy:web": "npm run deploy --workspace=apps/web",
    "deploy:api": "npm run deploy --workspace=apps/api",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "test": "npm run test --workspace=apps/api"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "devDependencies": {
    "typescript": "^5.3.3",
    "wrangler": "^4.151.2"
  }
}
